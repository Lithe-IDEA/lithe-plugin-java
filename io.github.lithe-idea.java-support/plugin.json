  "languages": [
    {
      "id": "java",
      "displayName": "Java",
      "fileExtensions": ["java"],
      "projectFileNames": ["pom.xml", "build.gradle", "build.gradle.kts", "settings.gradle", "settings.gradle.kts"]
    },
    {
      "id": "jsp",
      "displayName": "JavaServer Pages",
      "fileExtensions": [
        "jsp",
        "jspf",
        "tag",
        "tagf"
      ],
      "grammar": {
        "kind": "textmate",
        "path": "grammars/jsp.tmLanguage.json"
      },
      "configuration": {
        "blockComment": [
          "<%--",
          "--%>"
        ],
        "brackets": [
          [
            "{",
            "}"
          ],
          [
            "[",
            "]"
          ],
          [
            "(",
            ")"
          ]
        ],
        "autoClosingPairs": [
          [
            "{",
            "}"
          ],
          [
            "[",
            "]"
          ],
          [
            "(",
            ")"
          ],
          [
            "\"",
            "\""
          ],
          [
            "'",
            "'"
          ]
        ]
      }
    }
  ],
  "debugAdapters": [
    {
      "id": "java",
      "displayName": "Java Debugger",
      "adapterID": "java",
      "configurationTypes": ["java"],
      "requests": ["attach"],
      "selectors": [{"targetKinds": ["connection"], "languageIDs": ["java"]}],
      "launch": {
        "transport": "tcpLanguageServer",
        "endpoint": {"languageID": "java", "command": "vscode.java.startDebugSession"}
      },
      "configurations": {
        "attach": {"targetBindings": {"connection": {"host": "hostName", "port": "port"}}}
      },
      "features": {
        "hotCodeReplace": {
          "request": "redefineClasses",
          "event": "hotcodereplace",
          "changedField": "changedClasses",
          "errorField": "errorMessage"
        },
        "stepFilters": {"argument": "stepFilters"}
      },
      "defaults": {
        "stepFilters": {"classNameFilters": ["$JDK", "$Libraries"]}
      }
    }
  ],
  "settings": [
    {
      "id": "languageServerHome",
      "type": "directory",
      "title": "Language server folder",
      "description": "Optional folder of the verified Eclipse JDT Language Server 1.61.0. Leave empty to reuse a compatible installation or let Lithe prepare the pinned server and its separate Java 25 runtime. This does not change the project JDK.",
      "default": "",
      "placeholder": "Automatic",
      "page": {
        "languageID": "java"
      },
      "section": "Language server"
    },
    {
      "id": "heapMaxMB",
      "type": "integer",
      "title": "Maximum memory",
      "description": "Upper bound of the Java language server's heap. Raise it for large multi-module projects.",
      "default": 2048,
      "minimum": 2048,
      "maximum": 16384,
      "unit": "MB",
      "page": {"languageID": "java"},
      "section": "Language server"
    },
    {
      "id": "logLevel",
      "type": "enum",
      "title": "Language server log level",
      "description": "How much the Java language server writes to its own log. Quieter levels reduce disk writes.",
      "default": "WARNING",
      "options": [
        { "value": "ALL", "title": "All messages" },
        { "value": "INFO", "title": "Information" },
        { "value": "WARNING", "title": "Warnings" },
        { "value": "SEVERE", "title": "Errors only" }
      ],
      "page": {"languageID": "java"},
      "section": "Language server"
    },
    {
      "id": "projectModelDetection",
      "type": "boolean",
      "title": "Detect project models",
      "description": "For folders without Maven or Gradle, read the project layout other IDEs leave behind: Eclipse WTP containers (Web App Libraries, EAR Libraries, Server Runtime), IntelliJ IDEA modules and libraries, and WEB-INF/lib of legacy web projects. Lithe adds what they declare to the classpath in memory and never changes the project files. Changes apply when the Java language server restarts.",
      "default": true,
      "page": {"languageID": "java"},
      "section": "Project model"
    },
    {
      "id": "servletContainerHome",
      "type": "directory",
      "title": "Servlet container folder",
      "description": "Tomcat or Jetty installation that provides javax.servlet and the other server APIs to web projects, as Eclipse's Server Runtime and IDEA's application server libraries do. Leave empty to use CATALINA_HOME or TOMCAT_HOME, then a Tomcat installed in a standard folder, preferring the version the project names.",
      "default": "",
      "placeholder": "Automatic",
      "page": {"languageID": "java"},
      "section": "Project model"
    }
  ],
  "languageServers": [
    {
      "languageID": "java",
