{
  "schemaVersion": 0,
  "id": "io.github.lithe-idea.java-support",
  "displayName": "Java Support",
  "version": "1.1.3",
  "pluginAPIVersion": 0,
  "requires": {"backend": 0, "debugAdapters": 0, "languages": 0, "languageServers": 0, "pluginFunctions": 0, "settings": 0, "projectGenerators": 0, "toolDefinitions": 0},
  "requiresTools": ["java"],
  "vendor": {
    "id": "io.github.lithe-idea",
    "displayName": "Lithe Community",
    "signatureRequirement": "none"
  },
  "permissions": ["backend.launch", "documents.contentProvider", "documents.read", "editor.actions", "languageServer.launch", "languageServer.request", "project.generate", "debug.launch", "debug.attach", "debug.start", "run.start", "window.messages", "workspace.metadata"],
  "activationEvents": ["onLanguage:java", "onDebug:java"],
  "toolDefinitions": [
    {
      "id": "java",
      "displayName": "JDK",
      "icon": {
        "host": "plugin"
      },
      "executableLayouts": [
        {
          "path": "bin/java",
          "platforms": [
            "macos",
            "linux"
          ]
        },
        {
          "path": "bin/java.exe",
          "platforms": [
            "windows"
          ]
        }
      ],
      "executables": [
        {
          "id": "pinned",
          "kind": "setting",
          "settingID": "executable",
          "layer": "project"
        },
        {
          "id": "project-request",
          "kind": "toolchain",
          "scope": "project"
        },
        {
          "id": "default",
          "kind": "setting",
          "settingID": "executable",
          "layer": "global"
        },
        {
          "id": "global-request",
          "kind": "toolchain",
          "scope": "global"
        },
        {
          "id": "home",
          "kind": "environment",
          "variable": "JAVA_HOME",
          "path": "bin/java",
          "platforms": [
            "macos",
            "linux"
          ]
        },
        {
          "id": "home-windows",
          "kind": "environment",
          "variable": "JAVA_HOME",
          "path": "bin/java.exe",
          "platforms": [
            "windows"
          ]
        },
        {
          "id": "shell",
          "kind": "command",
          "command": "java"
        },
        {
          "id": "detected",
          "kind": "toolchain",
          "scope": "installed"
        }
      ],
      "version": {
        "arguments": [
          "-version"
        ],
        "pattern": "version \\\"(?:1\\.)?(\\d+(?:\\.\\d+)*)"
      },
      "homeLayouts": [
        {
          "match": "*.jdk",
          "home": "Contents/Home",
          "platforms": [
            "macos"
          ]
        },
        {
          "match": "*",
          "home": "."
        }
      ],
      "discovery": [
        {
          "root": {
            "kind": "absolute",
            "path": "/Library/Java/JavaVirtualMachines"
          },
          "pattern": "*.jdk",
          "platforms": [
            "macos"
          ]
        },
        {
          "root": {
            "kind": "home"
          },
          "pattern": "Library/Java/JavaVirtualMachines/*.jdk",
          "platforms": [
            "macos"
          ]
        }
      ],
      "homeVariable": "JAVA_HOME",
      "commands": [
        "java"
      ],
      "wrappers": [],
      "exports": [
        {
          "name": "JAVA_HOME",
          "value": "${home}"
        },
        {
          "name": "LITHE_JAVA_PATH",
          "value": "${executable}"
        }
      ],
      "pathPrepend": [
        "${home}/bin"
      ],
      "launch": [
        "${executable}",
        "${runtimeArguments}",
        "-jar",
        "${entry}",
        "${arguments}"
      ]
    }
  ],
  "languages": [
    {
      "id": "java",
      "displayName": "Java",
      "fileExtensions": ["java"],
      "projectFileNames": ["pom.xml", "build.gradle", "build.gradle.kts", "settings.gradle", "settings.gradle.kts"]
    }
  ],
  "debugAdapters": [
    {
      "id": "java",
      "displayName": "Java Debugger",
      "adapterID": "java",
      "configurationTypes": ["java"],
      "requests": ["attach"],
      "selectors": [{"targetKinds": ["connection"], "languageIDs": ["java"]}],
      "launch": {
        "transport": "tcpLanguageServer",
        "endpoint": {"languageID": "java", "command": "vscode.java.startDebugSession"}
      },
      "configurations": {
        "attach": {"targetBindings": {"connection": {"host": "hostName", "port": "port"}}}
      },
      "features": {
        "hotCodeReplace": {
          "request": "redefineClasses",
          "event": "hotcodereplace",
          "changedField": "changedClasses",
          "errorField": "errorMessage"
        },
        "stepFilters": {"argument": "stepFilters"}
      },
      "defaults": {
        "stepFilters": {"classNameFilters": ["$JDK", "$Libraries"]}
      }
    }
  ],
  "settings": [
    {
      "id": "heapMaxMB",
      "type": "integer",
      "title": "Maximum memory",
      "description": "Upper bound of the Java language server's heap. Raise it for large multi-module projects.",
      "default": 2048,
      "minimum": 2048,
      "maximum": 16384,
      "unit": "MB",
      "page": {"languageID": "java"},
      "section": "Language server"
    },
    {
      "id": "logLevel",
      "type": "enum",
      "title": "Language server log level",
      "description": "How much the Java language server writes to its own log. Quieter levels reduce disk writes.",
      "default": "WARNING",
      "options": [
        { "value": "ALL", "title": "All messages" },
        { "value": "INFO", "title": "Information" },
        { "value": "WARNING", "title": "Warnings" },
        { "value": "SEVERE", "title": "Errors only" }
      ],
      "page": {"languageID": "java"},
      "section": "Language server"
    }
  ],
  "languageServers": [
    {
      "languageID": "java",
      "languageIdentifier": "java",
      "launch": {
        "kind": "backend",
        "function": "java.resolveLaunch",
        "timeoutMilliseconds": 60000
      },
      "requestMethods": ["java/classFileContents", "workspace/executeCommand"],
      "commands": ["java.project.updateSettings", "vscode.java.buildWorkspace", "vscode.java.resolveClasspath", "vscode.java.resolveMainMethod", "vscode.java.test.findTestTypesAndMethods", "vscode.java.test.junit.argument"],
      "forwardNotifications": ["language/eventNotification", "language/progressReport", "language/status"],
      "state": {
        "scope": "workspace",
        "retention": {
          "maxEntries": 8,
          "maxAgeDays": 30
        }
      },
      "remote": "unsupported"
    }
  ],
  "pluginFunctions": {
    "calls": [
      {"id": "languageImport.settings", "version": 1}
    ],
    "exports": [
      {"id": "languageImport.settingsChanged", "version": 1, "context": "workspace"}
    ]
  },
  "backend": {
    "launch": {
      "kind": "packaged",
      "path": "bin/lithe-java-backend"
    }
  },
  "projectGenerators": [
    {
      "id": "java",
      "displayName": "Java",
      "description": "A Java project without a build tool.",
      "section": "project",
      "order": 10,
      "icon": {"path": "icons/java.svg", "darkPath": "icons/java_dark.svg", "mode": "original"},
      "fields": [
        {
          "id": "jdk",
          "type": "tool",
          "title": "JDK",
          "tool": "java",
          "minimumVersion": "11"
        },
        {
          "id": "addSampleCode",
          "type": "boolean",
          "title": "Add sample code",
          "default": true
        }
      ],
      "requirements": [
        {"languageID": "java"}
      ],
      "steps": [
        {"kind": "files", "source": "templates/java/plain"},
        {
          "kind": "files",
          "source": "templates/java/plain-sample",
          "when": {"field": "addSampleCode", "equals": true}
        },
        {
          "kind": "files",
          "source": "templates/java/plain-empty",
          "when": {"field": "addSampleCode", "equals": false}
        }
      ],
      "openFiles": [
        {"path": "src/Main.java", "when": {"field": "addSampleCode", "equals": true}}
      ]
    },
    {
      "id": "spring-boot",
      "displayName": "Spring Boot",
      "description": "A Spring Boot project from Spring Initializr.",
      "section": "generator",
      "order": 20,
      "icon": {"path": "icons/spring-boot.svg", "darkPath": "icons/spring-boot_dark.svg", "mode": "original"},
      "fields": [
        {
          "id": "serverUrl",
          "type": "text",
          "title": "Server URL",
          "description": "The Spring Initializr server that generates the project. Change it to use a mirror or your company's own server.",
          "default": "https://start.spring.io",
          "pattern": "(https://[A-Za-z0-9.-]+|http://(localhost|127\\.0\\.0\\.1))(:[0-9]+)?(/[A-Za-z0-9._~-]+)*",
          "maxLength": 256
        },
        {
          "id": "language",
          "type": "enum",
          "title": "Language",
          "presentation": "segmented",
          "options": [
            {"value": "java", "title": "Java"},
            {"value": "kotlin", "title": "Kotlin"},
            {"value": "groovy", "title": "Groovy"}
          ]
        },
        {
          "id": "type",
          "type": "enum",
          "title": "Type",
          "presentation": "segmented",
          "default": "maven-project",
          "options": [
            {"value": "gradle-project", "title": "Gradle - Groovy"},
            {"value": "gradle-project-kotlin", "title": "Gradle - Kotlin"},
            {"value": "maven-project", "title": "Maven"}
          ]
        },
        {
          "id": "groupId",
          "type": "text",
          "title": "Group",
          "description": "Usually the reversed domain name of your organization, such as com.example.",
          "default": "com.example",
          "pattern": "[A-Za-z_][A-Za-z0-9_]*(\\.[A-Za-z_][A-Za-z0-9_]*)*",
          "maxLength": 200
        },
        {
          "id": "artifactId",
          "type": "text",
          "title": "Artifact",
          "description": "The name of the artifact the build produces.",
          "default": "${project.name}",
          "pattern": "[A-Za-z0-9_][A-Za-z0-9_.-]*",
          "maxLength": 200
        },
        {
          "id": "packageName",
          "type": "text",
          "title": "Package name",
          "default": "${field.groupId}.${field.artifactId|package}",
          "pattern": "[A-Za-z_][A-Za-z0-9_]*(\\.[A-Za-z_][A-Za-z0-9_]*)*",
          "maxLength": 200
        },
        {
          "id": "jdk",
          "type": "tool",
          "title": "JDK",
          "description": "The JDK the new project uses. It must be at least the Java version below.",
          "tool": "java",
          "minimumVersion": "17"
        },
        {
          "id": "javaVersion",
          "type": "enum",
          "title": "Java",
          "maximumVersion": "${field.jdk.major}",
          "presentation": "menu",
          "default": "17",
          "options": [
            {"value": "17", "title": "17"},
            {"value": "21", "title": "21"},
            {"value": "25", "title": "25"}
          ]
        },
        {
          "id": "packaging",
          "type": "enum",
          "title": "Packaging",
          "presentation": "segmented",
          "options": [
            {"value": "jar", "title": "Jar"},
            {"value": "war", "title": "War"}
          ]
        },
        {
          "id": "configurationFileFormat",
          "type": "enum",
          "title": "Configuration",
          "presentation": "segmented",
          "options": [
            {"value": "properties", "title": "Properties"},
            {"value": "yaml", "title": "YAML"}
          ]
        },
        {
          "id": "bootVersion",
          "type": "text",
          "title": "Spring Boot",
          "description": "Leave empty to use the version the server recommends.",
          "optional": true,
          "pattern": "[0-9]+\\.[0-9]+\\.[0-9]+(-[A-Za-z0-9.]+)?",
          "maxLength": 64,
          "placeholder": "Server default"
        },
        {
          "id": "dependencies",
          "type": "multiSelect",
          "title": "Dependencies",
          "options": [
            {"value": "devtools", "title": "Spring Boot DevTools", "group": "Developer Tools"},
            {"value": "lombok", "title": "Lombok", "group": "Developer Tools"},
            {"value": "configuration-processor", "title": "Configuration Processor", "group": "Developer Tools"},
            {"value": "web", "title": "Spring Web", "group": "Web"},
            {"value": "webflux", "title": "Spring Reactive Web", "group": "Web"},
            {"value": "thymeleaf", "title": "Thymeleaf", "group": "Template Engines"},
            {"value": "security", "title": "Spring Security", "group": "Security"},
            {"value": "oauth2-client", "title": "OAuth2 Client", "group": "Security"},
            {"value": "oauth2-resource-server", "title": "OAuth2 Resource Server", "group": "Security"},
            {"value": "data-jpa", "title": "Spring Data JPA", "group": "SQL"},
            {"value": "jdbc", "title": "JDBC API", "group": "SQL"},
            {"value": "mybatis", "title": "MyBatis Framework", "group": "SQL"},
            {"value": "flyway", "title": "Flyway Migration", "group": "SQL"},
            {"value": "liquibase", "title": "Liquibase Migration", "group": "SQL"},
            {"value": "mysql", "title": "MySQL Driver", "group": "SQL"},
            {"value": "postgresql", "title": "PostgreSQL Driver", "group": "SQL"},
            {"value": "h2", "title": "H2 Database", "group": "SQL"},
            {"value": "data-redis", "title": "Spring Data Redis", "group": "NoSQL"},
            {"value": "data-mongodb", "title": "Spring Data MongoDB", "group": "NoSQL"},
            {"value": "data-elasticsearch", "title": "Spring Data Elasticsearch", "group": "NoSQL"},
            {"value": "amqp", "title": "Spring for RabbitMQ", "group": "Messaging"},
            {"value": "kafka", "title": "Spring for Apache Kafka", "group": "Messaging"},
            {"value": "validation", "title": "Validation", "group": "I/O"},
            {"value": "mail", "title": "Java Mail Sender", "group": "I/O"},
            {"value": "cache", "title": "Spring Cache Abstraction", "group": "I/O"},
            {"value": "quartz", "title": "Quartz Scheduler", "group": "I/O"},
            {"value": "actuator", "title": "Spring Boot Actuator", "group": "Ops"},
            {"value": "testcontainers", "title": "Testcontainers", "group": "Testing"}
          ]
        }
      ],
      "requirements": [
        {"languageID": "java", "when": {"field": "language", "equals": "java"}},
        {"languageID": "kotlin", "when": {"field": "language", "equals": "kotlin"}},
        {"languageID": "groovy", "when": {"field": "language", "equals": "groovy"}},
        {"buildSystemID": "maven", "when": {"field": "type", "equals": "maven-project"}},
        {"buildSystemID": "gradle", "when": {"field": "type", "oneOf": ["gradle-project", "gradle-project-kotlin"]}}
      ],
      "steps": [
        {
          "kind": "archive",
          "url": "${field.serverUrl}/starter.zip",
          "query": [
            {"name": "type", "value": "${field.type}"},
            {"name": "language", "value": "${field.language}"},
            {"name": "bootVersion", "value": "${field.bootVersion}", "omitEmpty": true},
            {"name": "groupId", "value": "${field.groupId}"},
            {"name": "artifactId", "value": "${field.artifactId}"},
            {"name": "name", "value": "${project.name}"},
            {"name": "packageName", "value": "${field.packageName}"},
            {"name": "packaging", "value": "${field.packaging}"},
            {"name": "javaVersion", "value": "${field.javaVersion}"},
            {"name": "configurationFileFormat", "value": "${field.configurationFileFormat}"},
            {"name": "dependencies", "value": "${field.dependencies}", "omitEmpty": true}
          ]
        }
      ],
      "openFiles": [
        {"path": "pom.xml", "when": {"field": "type", "equals": "maven-project"}},
        {"path": "build.gradle", "when": {"field": "type", "equals": "gradle-project"}},
        {"path": "build.gradle.kts", "when": {"field": "type", "equals": "gradle-project-kotlin"}}
      ]
    }
  ]
}
